generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  firebaseId    String?  @unique // To link with Firebase Auth later
  email         String   @unique
  fullName      String
  role          Role     @default(PATIENT)
  
  // New profile fields
  contactNumber String?
  cnic          String?
  gender        String?
  address       String?
  
  // Relations
  doctorProfile    DoctorProfile?
  patientProfile   PatientProfile?
  
  appointmentsAsPatient Appointment[] @relation("PatientAppointments")
  appointmentsAsDoctor  Appointment[] @relation("DoctorAppointments")
  
  prescriptionsAsPatient Prescription[] @relation("PatientPrescriptions")
  prescriptionsAsDoctor  Prescription[] @relation("DoctorPrescriptions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DoctorProfile {
  id         String   @id @default(uuid())
  specialty  String
  experience Int?     // Years of experience
  bio        String?
  licenseNo  String?
  workingDays String[] @default([])
  workingHoursStart String?
  workingHoursEnd String?
  isApproved Boolean  @default(false)
  
  // Relation back to User
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PatientProfile {
  id             String   @id @default(uuid())
  age            Int?
  medicalHistory String?
  
  // Relation back to User
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Appointment {
  id        String   @id @default(uuid())
  date      String   // Using string for easy display (e.g. "2026-05-20"), can use DateTime later
  time      String   // E.g. "10:30 AM"
  status    String   @default("Scheduled") // Scheduled, Completed, Cancelled
  notes     String?
  
  // Relations
  patientId String
  patient   User     @relation("PatientAppointments", fields: [patientId], references: [id])
  
  doctorId  String
  doctor    User     @relation("DoctorAppointments", fields: [doctorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Prescription {
  id        String   @id @default(uuid())
  date      String
  
  // Relations
  patientId String
  patient   User     @relation("PatientPrescriptions", fields: [patientId], references: [id])
  
  doctorId  String
  doctor    User     @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  
  medications Medication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Medication {
  id             String       @id @default(uuid())
  name           String
  dosage         String
  instructions   String
  duration       String
  times          String[]     // Array of strings, supported natively in PostgreSQL

  // Relation back to Prescription
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String   @unique
  code      String   @default("")
  expiresAt DateTime @default(now())
  createdAt DateTime @default(now())
}

